# Where the app reaches Marsa ERP's portal API (the wholesale portal's host, which serves /v1).
EXPO_PUBLIC_API_URL=https://wholesale.itsmarsa.com
# The Origin the app sends on writes; must be listed in the API's PORTAL_ORIGINS.
EXPO_PUBLIC_PORTAL_ORIGIN=https://wholesale.itsmarsa.com
# Ad attribution (MARKETING.md): "on" asks for tracking consent and lets the ERP forward conversions to ad
# platforms. Leave off for the first App Store submission.
EXPO_PUBLIC_AD_ATTRIBUTION=off
# Where account-deletion requests go when the customer has no rep (confirm this inbox exists).
EXPO_PUBLIC_SUPPORT_EMAIL=wholesale@itsmarsa.com
